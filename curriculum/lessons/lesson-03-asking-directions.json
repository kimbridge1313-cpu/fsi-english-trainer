        {
          "cue": "the supermarket",
          "answer": "How do I get to the supermarket?"
        },
        {
          "cue": "the city hall",
          "answer": "How do I get to the city hall?"
        },
        {
          "cue": "the park",
          "answer": "How do I get to the park?"
        },
        {
          "cue": "the bus stop",
          "answer": "How do I get to the bus stop?"
        },
        {
          "cue": "the pharmacy",
          "answer": "How do I get to the pharmacy?"
        },
        {
          "cue": "the bank",
          "answer": "How do I get to the bank?"
        },
        {
          "cue": "the post office",
          "answer": "How do I get to the post office?"
        }
      ]
    },
    "buildup": {
      "instruction": "每次增加片語，重新說出完整句。",
      "items": [
        {
          "label": "找車站",
          "steps": [
            "Where is the station?",
            "Where is the train station?",
            "Excuse me, where is the train station?"
          ]
        },
        {
          "label": "延伸路線",
          "steps": [
            "Go straight.",
            "Go straight for two blocks.",
            "Go straight for two blocks and turn left."
          ]
        },
        {
          "label": "確認位置",
          "steps": [
            "It's near the park.",
            "It's near the park on Main Street.",
            "It's near the park on Main Street, across from the bank."
          ]
        }
      ]
    },
    "transformation": {
      "instruction": "依照轉換規則重新說一次句子，再核對答案。",
      "items": [
        {
          "original": "You can walk to the museum.",
          "rule": "轉成疑問句",
          "answer": "Can you walk to the museum?"
        },
        {
          "original": "The library is far.",
          "rule": "轉成否定句",
          "answer": "The library isn't far."
        },
        {
          "original": "Turn left here.",
          "rule": "改成禮貌的請求句",
          "answer": "Could you turn left here, please?"
        },
        {
          "original": "The bank is on this street.",
          "rule": "轉成一般疑問句",
          "answer": "Is the bank on this street?"
        },
        {
          "original": "We need a map.",
          "rule": "轉成否定句",
          "answer": "We don't need a map."
        },
        {
          "original": "This bus stops at the station.",
          "rule": "轉成疑問句",
          "answer": "Does this bus stop at the station?"
        }
      ]
    },
    "response": {
      "instruction": "A 每次說一句，你接著回答 B。同一段問答依序練三輪，每輪加快語速。",
      "rates": [
        0.75,
        0.95,
        1.15
      ],
      "pairs": [
        {
          "a": "Excuse me, where is the museum?",
          "b": "It's two blocks away."
        },
        {
          "a": "Should I turn left at the light?",
          "b": "Yes, turn left there."
        },
        {
          "a": "Is the station far from here?",
          "b": "No, it's a short walk."
        },
        {
          "a": "Is the bank near the park?",
          "b": "Yes, it's across from the park."
        },
        {
          "a": "Could you say that again?",
          "b": "Sure. Go straight and turn right."
        }
      ]
    }
  },
  "conversation": {
    "instruction": "完成對話情境，先自己回答，再看參考答案。三輪逐步減少提示並加入變化。",
    "rounds": [
      {
        "name": "引導",
        "rate": 0.8,
        "scenario": "第一次練習：問路與指引",
        "pairs": [
          {
