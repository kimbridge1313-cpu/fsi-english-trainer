  "chunks": [
    {
      "id": "c01",
      "text": "How do I get to...?",
      "meaning": "我要怎麼去……？",
      "usage": "詢問路線",
      "example": "How do I get to the station?"
    },
    {
      "id": "c02",
      "text": "go straight",
      "meaning": "直走",
      "usage": "說明方向",
      "example": "Go straight for two blocks."
    },
    {
      "id": "c03",
      "text": "turn left",
      "meaning": "左轉",
      "usage": "轉彎指令",
      "example": "Turn left at the light."
    },
    {
      "id": "c04",
      "text": "turn right",
      "meaning": "右轉",
      "usage": "轉彎指令",
      "example": "Turn right at the corner."
    },
    {
      "id": "c05",
      "text": "across from...",
      "meaning": "在……正對面",
      "usage": "描述相對位置",
      "example": "It's across from the bank."
    },
    {
      "id": "c06",
      "text": "Is it far from here?",
      "meaning": "離這裡遠嗎？",
      "usage": "詢問距離",
      "example": "Is it far from here?"
    }
  ],
  "drills": {
    "substitution": {
      "instruction": "固定句型不變，只替換提示詞組。先說出完整句，再核對答案。",
      "pattern": "How do I get to ____?",
      "items": [
        {
          "cue": "the train station",
          "answer": "How do I get to the train station?"
        },
        {
          "cue": "the library",
          "answer": "How do I get to the library?"
        },
        {
