    "adaptation_notice": "本課參照原教材的點餐情境與語用功能。練習題、替換組合與完整對話為重新編寫的訓練內容；並非官方逐字轉錄，也不是官方 FSI 課程。"
  },
  "chunks": [
    {
      "id": "c01",
      "text": "I'll have...",
      "meaning": "我要點……",
      "usage": "自然地表達自己的點餐選擇",
      "example": "I'll have iced tea, please."
    },
    {
      "id": "c02",
      "text": "to start",
      "meaning": "先來……（前菜）",
      "usage": "先點一道開胃菜",
      "example": "I'll have soup to start."
    },
    {
      "id": "c03",
      "text": "for my main course",
      "meaning": "作為我的主餐",
      "usage": "指定主要餐點",
      "example": "I'll have the fish for my main course."
    },
    {
      "id": "c04",
      "text": "with...",
      "meaning": "搭配……",
      "usage": "加入配菜或其他選項",
      "example": "I'll have the fish with potatoes."
    },
    {
      "id": "c05",
      "text": "instead of...",
      "meaning": "用……取代……",
      "usage": "更換配菜",
      "example": "Could I have rice instead of fries?"
    },
    {
      "id": "c06",
      "text": "Could I have...?",
      "meaning": "請問可以給我……嗎？",
      "usage": "禮貌提出點餐要求",
      "example": "Could I have iced tea, please?"
    },
    {
      "id": "c07",
      "text": "That's all.",
      "meaning": "就這些了",
      "usage": "表達已點完餐",
      "example": "No, that's all. Thank you."
    }
  ],
