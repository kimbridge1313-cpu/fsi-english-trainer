  "chunks": [
    {
      "id": "c01",
      "text": "I need help with...",
      "meaning": "我需要協助處理……",
      "usage": "說明求助對象",
      "example": "I need help with my car."
    },
    {
      "id": "c02",
      "text": "I'm calling about...",
      "meaning": "我打電話是關於……",
      "usage": "說明來電原因",
      "example": "I'm calling about a lost bag."
    },
    {
      "id": "c03",
      "text": "I'm at...",
      "meaning": "我位於……",
      "usage": "交代位置",
      "example": "I'm at the front entrance."
    },
    {
      "id": "c04",
      "text": "Could you send someone?",
      "meaning": "可以派人來嗎？",
      "usage": "請求協助",
      "example": "Could you send someone, please?"
    },
    {
      "id": "c05",
      "text": "Please stay on the line.",
      "meaning": "請不要掛線",
      "usage": "確認電話流程",
      "example": "Okay, I'll stay on the line."
    },
    {
      "id": "c06",
      "text": "What should I do now?",
      "meaning": "我現在該怎麼做？",
      "usage": "詢問下一步",
      "example": "What should I do now?"
    }
  ],
  "drills": {
    "substitution": {
      "instruction": "固定句型不變，只替換提示詞組。先說出完整句，再核對答案。",
      "pattern": "I need help with ____.",
      "items": [
        {
          "cue": "my phone",
          "answer": "I need help with my phone."
        },
        {
          "cue": "my car",
          "answer": "I need help with my car."
        },
        {
          "cue": "a lost bag",
          "answer": "I need help with a lost bag."
        },
        {
          "cue": "a locked door",
          "answer": "I need help with a locked door."
        },
        {
          "cue": "a flat tire",
          "answer": "I need help with a flat tire."
        },
        {
          "cue": "my reservation",
          "answer": "I need help with my reservation."
        },
        {
          "cue": "a broken window",
          "answer": "I need help with a broken window."
        },
        {
          "cue": "my laptop",
          "answer": "I need help with my laptop."
        },
        {
          "cue": "a missing package",
          "answer": "I need help with a missing package."
        },
        {
          "cue": "an urgent problem",
          "answer": "I need help with an urgent problem."
        }
      ]
    },
    "buildup": {
      "instruction": "每次增加片語，重新說出完整句。",
      "items": [
        {
          "label": "說出位置",
          "steps": [
            "I'm outside.",
            "I'm outside the building.",
            "I'm outside the building near the main entrance."
          ]
        },
        {
          "label": "請求協助",
          "steps": [
            "I need help.",
            "I need help with my car.",
            "I need help with my car in the parking lot."
          ]
        },
        {
          "label": "說明物品遺失",
          "steps": [
            "I lost my bag.",
            "I lost my black bag.",
            "I lost my black bag near the bus station."
          ]
        }
      ]
    },
    "transformation": {
      "instruction": "依照轉換規則重新說一次句子，再核對答案。",
      "items": [
        {
          "original": "I need help.",
          "rule": "轉成否定句",
          "answer": "I don't need help."
        },
        {
          "original": "You are at the entrance.",
          "rule": "轉成疑問句",
          "answer": "Are you at the entrance?"
        },
        {
          "original": "She called yesterday.",
          "rule": "轉成否定句",
          "answer": "She didn't call yesterday."
        },
        {
          "original": "They can send someone.",
          "rule": "轉成疑問句",
          "answer": "Can they send someone?"
        },
        {
          "original": "I know the address.",
          "rule": "轉成否定句",
          "answer": "I don't know the address."
        },
        {
          "original": "Send someone.",
          "rule": "改成禮貌請求",
          "answer": "Could you send someone, please?"
        }
      ]
    },
    "response": {
      "instruction": "A 每次說一句，你接著回答 B。同一段問答依序練三輪，每輪加快語速。",
      "rates": [
        0.75,
        0.95,
        1.15
      ],
      "pairs": [
        {
          "a": "What are you calling about?",
          "b": "I'm calling about a lost bag."
        },
        {
          "a": "Where are you now?",
          "b": "I'm near the front entrance."
        },
        {
          "a": "Is anyone with you?",
          "b": "Yes, a friend is here."
        },
        {
          "a": "Could you describe the problem?",
          "b": "My car won't start."
        },
        {
          "a": "Can you stay on the line?",
          "b": "Yes, I'll stay on the line."
        }
      ]
    }
