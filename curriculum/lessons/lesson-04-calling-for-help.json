  "conversation": {
    "instruction": "完成對話情境，先自己回答，再看參考答案。三輪逐步減少提示並加入變化。",
    "rounds": [
      {
        "name": "引導",
        "rate": 0.8,
        "scenario": "第一次練習：電話求助",
        "pairs": [
